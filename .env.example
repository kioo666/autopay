# Generate both values using python setup_local.py
MASTER_KEY=
APP_TOKEN=
HEADLESS=false
GOOGLE_CLIENT_FILE=credentials.json
DATA_DIR=data
# Must match the port used to run Uvicorn. Web OAuth clients must register this exact redirect.
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback
# Optional installed Chromium path
# BROWSER_EXECUTABLE=/path/to/chromium
# Hosted mode only: exact public HTTPS origin; callback is derived from this value.
# PUBLIC_BASE_URL=https://your-service.up.railway.app
# GOOGLE_CLIENT_JSON is set as a hosting secret; do not commit or share its value.
